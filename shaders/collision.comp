#version 440 core

layout(local_size_x = 64) in;
struct ObjectState { vec4 position; vec4 velocity; };
struct ObjectControl { uint initializing; uint launched; uint target; uint id; };
struct ObjectDerived { vec4 radiusRs; };
layout(std430, binding = 0) readonly buffer StateBuffer { ObjectState objects[]; };
layout(std430, binding = 3) readonly buffer ControlBuffer { ObjectControl controls[]; };
layout(std430, binding = 9) readonly buffer MetadataBuffer { uvec4 metadata; };
layout(std430, binding = 12) readonly buffer DerivedBuffer { ObjectDerived derived[]; };
layout(std430, binding = 15) writeonly buffer CollisionBuffer { uint collisions[]; };
uniform uint u_objectCount;

void main()
{
    uint target = gl_GlobalInvocationID.x;
    if (target >= u_objectCount) return;
    uint count = 0u;
    if (metadata.y == 0u && controls[target].initializing == 0u)
    {
        for (uint source = 0u; source < u_objectCount; ++source)
        {
            if (source == target || controls[source].initializing != 0u) continue;
            float distance = length(objects[source].position.xyz - objects[target].position.xyz);
            if (distance > 0.0 && derived[source].radiusRs.x + derived[target].radiusRs.x > distance)
                ++count;
        }
    }
    collisions[target] = count;
}
