#version 440 core

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) readonly buffer CurrentState
{
    ObjectState objects[];
};

layout(std430, binding = 6) writeonly buffer ObjectCellID
{
    uint cellIDs[];
};

uniform vec3 u_worldMin;
uniform float u_cell_size;
uniform uint u_gridX;
uniform uint u_gridY;

void main()
{
    uint objectID = gl_GlobalInvocationID.x;
    if (objectID>= u_objectCount)
        return;
    vec3 position = objects[objectID].position.xyz;
    vec3 relative_position = position - u_worldMin;
    ivec3 cellcoord = ivec3(floor(relative_position/u_cell_size));
    uint cellID = uint(cellcoord.x);
    cellIDs[objectID] = cellID;
}