#version 440 core

layout(local_size_x = 64) in;
struct ObjectState { vec4 position; vec4 velocity; };
struct ObjectPhysical { vec4 massDensity; };
struct ObjectControl { uint initializing; uint launched; uint target; uint id; };
struct Node { vec4 centerHalf; uvec4 children0; uvec4 children1; uvec4 data; };
layout(std430, binding = 0) readonly buffer StateBuffer { ObjectState objects[]; };
layout(std430, binding = 2) readonly buffer PhysicalBuffer { ObjectPhysical physical[]; };
layout(std430, binding = 3) readonly buffer ControlBuffer { ObjectControl controls[]; };
layout(std430, binding = 6) readonly buffer AggregateBuffer { vec4 aggregate[]; };
layout(std430, binding = 7) readonly buffer NodeBuffer { Node nodes[]; };
layout(std430, binding = 8) readonly buffer IndexBuffer { uvec2 objectIndex[]; };
layout(std430, binding = 9) readonly buffer MetadataBuffer { uvec4 metadata; };
layout(std430, binding = 13) writeonly buffer AccelerationBuffer { vec4 accelerations[]; };
uniform uint u_objectCount;
uniform double u_gravitationalConstant;
uniform float u_epsilon;
uniform float u_theta;

const uint none = 0xffffffffu;
const uint maxDepth = 8u;

uint childAt(uint index, uint octant)
{
    return octant < 4u ? nodes[index].children0[octant] : nodes[index].children1[octant - 4u];
}

uint octantFor(vec3 position, vec3 center)
{
    return (position.x >= center.x ? 1u : 0u) |
           (position.y >= center.y ? 2u : 0u) |
           (position.z >= center.z ? 4u : 0u);
}

vec3 force(vec3 displacement, float sourceMass, float targetMass)
{
    float distance = length(displacement);
    if (distance <= 0.0) return vec3(0.0);
    float meters = distance * 1000.0;
    float softened = meters * meters + u_epsilon * u_epsilon;
    double gravitationalForce = u_gravitationalConstant * double(targetMass) *
                                double(sourceMass) / double(softened);
    return displacement / distance * float(gravitationalForce / double(targetMass));
}

void main()
{
    uint target = gl_GlobalInvocationID.x;
    if (target >= u_objectCount) return;
    vec3 total = vec3(0.0);
    if (metadata.y == 0u && controls[target].initializing == 0u)
    {
        vec3 position = objects[target].position.xyz;
        float targetMass = physical[target].massDensity.x;
        uint stack[64];
        bool containsTarget[64];
        uint size = 1u;
        stack[0] = 0u;
        containsTarget[0] = true;
        while (size > 0u)
        {
            --size;
            uint node = stack[size];
            bool contains = containsTarget[size];
            if (nodes[node].data.y == maxDepth)
            {
                for (uint source = nodes[node].data.x; source != none; source = objectIndex[source].x)
                    if (source != target)
                        total += force(objects[source].position.xyz - position,
                                       physical[source].massDensity.x, targetMass);
                continue;
            }
            vec3 displacement = aggregate[node].xyz - position;
            float distance = length(displacement);
            if (!contains && nodes[node].data.z != 0u && distance > 0.0 &&
                nodes[node].centerHalf.w * 2.0 < u_theta * distance)
            {
                total += force(displacement, aggregate[node].w, targetMass);
                continue;
            }
            uint targetOctant = octantFor(position, nodes[node].centerHalf.xyz);
            for (uint octant = 0u; octant < 8u; ++octant)
            {
                uint child = childAt(node, octant);
                if (child == none) continue;
                stack[size] = child;
                containsTarget[size] = contains && octant == targetOctant;
                ++size;
            }
        }
    }
    accelerations[target] = vec4(total, 0.0);
}
