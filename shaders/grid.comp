#version 440 core

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 1) readonly buffer GridSourcesBuffer { vec4 sources[]; };
layout(std430, binding = 4) readonly buffer BaseGridBuffer { vec4 basePositions[]; };
layout(std430, binding = 5) writeonly buffer DeformedGridBuffer { vec4 deformedPositions[]; };

uniform uint u_sourceCount;
uniform uint u_gridWidth;
uniform uint u_gridHeight;
uniform float u_metersPerWorldUnit;
uniform float u_deformationAmplitudeWorld;
uniform float u_clampDelta;

void main()
{
    uint x = gl_GlobalInvocationID.x;
    uint z = gl_GlobalInvocationID.y;
    if (x >= u_gridWidth || z >= u_gridHeight)
    {
        return;
    }

    uint gridIndex = z * u_gridWidth + x;
    vec3 basePosition = basePositions[gridIndex].xyz;
    float totalDisplacement = 0.0;
    float minFactor = 1.0 + u_clampDelta;
    for (uint i = 0u; i < u_sourceCount; ++i)
    {
        vec4 src = sources[i];
        vec3 objPos = src.xyz;
        float objRs = src.w;
        vec3 toObject = objPos - basePosition;
        float distance_m = length(toObject) * u_metersPerWorldUnit;

        distance_m = max(distance_m, objRs * minFactor);

        if (objRs > 0.0)
        {
            totalDisplacement -= (u_deformationAmplitudeWorld * objRs) / distance_m;
        }
    }

    deformedPositions[gridIndex] =
        vec4(basePosition.x, basePosition.y + totalDisplacement, basePosition.z, 1.0);
}
