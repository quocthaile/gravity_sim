#version 440 core

layout(local_size_x = 64) in;

struct ObjectState { vec4 position; vec4 velocity; };
struct ObjectPhysical { vec4 massDensity; };
struct ObjectControl { uint initializing; uint launched; uint target; uint id; };
struct Node { vec4 centerHalf; uvec4 children0; uvec4 children1; uvec4 data; };

layout(std430, binding = 0) readonly buffer StateBuffer { ObjectState objects[]; };
layout(std430, binding = 2) readonly buffer PhysicalBuffer { ObjectPhysical physical[]; };
layout(std430, binding = 3) readonly buffer ControlBuffer { ObjectControl controls[]; };
layout(std430, binding = 6) buffer AggregateBuffer { vec4 aggregate[]; };
layout(std430, binding = 7) buffer NodeBuffer { Node nodes[]; };
layout(std430, binding = 8) buffer IndexBuffer { uvec2 objectIndex[]; };
layout(std430, binding = 9) buffer MetadataBuffer { uvec4 metadata; };

uniform uint u_objectCount;
uniform uint u_nodeCapacity;
uniform uint u_pass;
uniform uint u_depth;

const uint none = 0xffffffffu;
const uint maxDepth = 8u;

bool finiteFloat(float value) { return !isnan(value) && !isinf(value); }
bool finiteVec3(vec3 value) { return all(not(isnan(value))) && all(not(isinf(value))); }

uint childAt(uint index, uint octant)
{
    return octant < 4u ? nodes[index].children0[octant] : nodes[index].children1[octant - 4u];
}

void setChild(uint index, uint octant, uint child)
{
    if (octant < 4u) nodes[index].children0[octant] = child;
    else nodes[index].children1[octant - 4u] = child;
}

uint octantFor(vec3 position, vec3 center)
{
    return (position.x >= center.x ? 1u : 0u) |
           (position.y >= center.y ? 2u : 0u) |
           (position.z >= center.z ? 4u : 0u);
}

void initNode(uint index, vec3 center, float halfSize, uint depth)
{
    nodes[index].centerHalf = vec4(center, halfSize);
    nodes[index].children0 = uvec4(none);
    nodes[index].children1 = uvec4(none);
    nodes[index].data = uvec4(none, depth, 0u, 0u);
    aggregate[index] = vec4(0.0);
}

void initializeRoot()
{
    metadata = uvec4(0u);
    if (u_nodeCapacity == 0u)
    {
        metadata.y = 1u;
        return;
    }
    dvec3 minimum = dvec3(0.0);
    dvec3 maximum = dvec3(0.0);
    bool hasObject = false;
    for (uint i = 0u; i < u_objectCount; ++i)
    {
        if (controls[i].initializing != 0u) continue;
        vec3 position = objects[i].position.xyz;
        if (!finiteVec3(position) || !finiteFloat(physical[i].massDensity.x))
        {
            metadata.y = 2u;
            return;
        }
        if (!hasObject)
        {
            minimum = maximum = dvec3(position);
            hasObject = true;
        }
        else
        {
            minimum = min(minimum, dvec3(position));
            maximum = max(maximum, dvec3(position));
        }
    }
    dvec3 middle = (minimum + maximum) * 0.5;
    dvec3 extent = (maximum - minimum) * 0.5;
    float halfSize = max(float(max(max(extent.x, extent.y), extent.z) * 1.00001), 1e-20);
    vec3 center = vec3(middle);
    if (!finiteFloat(halfSize) || !finiteVec3(center))
    {
        metadata.y = 2u;
        return;
    }
    initNode(0u, center, halfSize, 0u);
    metadata.x = 1u;
}

void markOctant(uint i)
{
    if (i == 0u) metadata.z = metadata.x;
    if (i >= u_objectCount || controls[i].initializing != 0u) return;
    uint node = u_depth == 0u ? 0u : objectIndex[i].y;
    vec3 position = objects[i].position.xyz;
    if (u_depth != 0u)
        node = childAt(node, octantFor(position, nodes[node].centerHalf.xyz));
    objectIndex[i].y = node;
    uint octant = octantFor(position, nodes[node].centerHalf.xyz);
    atomicOr(nodes[node].data.w, 1u << octant);
}

void allocateChildren(uint node)
{
    if (node >= metadata.z || nodes[node].data.y != u_depth) return;
    uint mask = nodes[node].data.w;
    for (uint octant = 0u; octant < 8u; ++octant)
    {
        if ((mask & (1u << octant)) == 0u) continue;
        uint child = atomicAdd(metadata.x, 1u);
        if (child >= u_nodeCapacity)
        {
            atomicOr(metadata.y, 1u);
            continue;
        }
        float childHalf = nodes[node].centerHalf.w * 0.5;
        vec3 signVector = vec3((octant & 1u) != 0u ? 1.0 : -1.0,
                               (octant & 2u) != 0u ? 1.0 : -1.0,
                               (octant & 4u) != 0u ? 1.0 : -1.0);
        vec3 childCenter = nodes[node].centerHalf.xyz + signVector * childHalf;
        if (!finiteVec3(childCenter))
        {
            atomicOr(metadata.y, 2u);
            continue;
        }
        initNode(child, childCenter, childHalf, u_depth + 1u);
        setChild(node, octant, child);
    }
}

void linkLeaf(uint i)
{
    if (i >= u_objectCount || controls[i].initializing != 0u) return;
    uint parent = objectIndex[i].y;
    uint octant = octantFor(objects[i].position.xyz, nodes[parent].centerHalf.xyz);
    uint leaf = childAt(parent, octant);
    objectIndex[i].x = atomicExchange(nodes[leaf].data.x, i);
}

uint sortLeaf(uint head)
{
    // Atomic insertion order is driver-dependent; sort each leaf by object slot.
    uint width = 1u;
    while (head != none)
    {
        uint inputHead = head;
        uint outputHead = none;
        uint tail = none;
        uint runs = 0u;
        while (inputHead != none)
        {
            ++runs;
            uint left = inputHead;
            uint leftCount = 0u;
            for (; leftCount < width && inputHead != none; ++leftCount)
                inputHead = objectIndex[inputHead].x;
            uint right = inputHead;
            uint rightCount = width;
            while (leftCount > 0u || (rightCount > 0u && right != none))
            {
                uint selected;
                if (leftCount == 0u)
                {
                    selected = right;
                    right = objectIndex[right].x;
                    --rightCount;
                }
                else if (rightCount == 0u || right == none || left < right)
                {
                    selected = left;
                    left = objectIndex[left].x;
                    --leftCount;
                }
                else
                {
                    selected = right;
                    right = objectIndex[right].x;
                    --rightCount;
                }
                if (tail == none) outputHead = selected;
                else objectIndex[tail].x = selected;
                tail = selected;
            }
            inputHead = right;
        }
        objectIndex[tail].x = none;
        head = outputHead;
        if (runs <= 1u) break;
        width *= 2u;
    }
    return head;
}

void aggregateNode(uint node)
{
    if (node >= metadata.x || nodes[node].data.y != u_depth) return;
    double mass = 0.0;
    dvec3 weighted = dvec3(0.0);
    bool usable = true;
    bool hasMass = false;
    if (u_depth == maxDepth)
    {
        nodes[node].data.x = sortLeaf(nodes[node].data.x);
        for (uint i = nodes[node].data.x; i != none; i = objectIndex[i].x)
        {
            double m = double(physical[i].massDensity.x);
            if (m <= 0.0) usable = false;
            mass += m;
            weighted += m * dvec3(objects[i].position.xyz);
            hasMass = true;
        }
    }
    else
    {
        for (uint octant = 0u; octant < 8u; ++octant)
        {
            uint child = childAt(node, octant);
            if (child == none) continue;
            if (nodes[child].data.z == 0u) usable = false;
            double m = double(aggregate[child].w);
            mass += m;
            weighted += m * dvec3(aggregate[child].xyz);
            hasMass = true;
        }
    }
    if (usable && hasMass && mass > 0.0)
    {
        float storedMass = float(mass);
        vec3 com = vec3(weighted / mass);
        if (finiteFloat(storedMass) && finiteVec3(com))
        {
            aggregate[node] = vec4(com, storedMass);
            nodes[node].data.z = 1u;
        }
    }
}

void main()
{
    uint id = gl_GlobalInvocationID.x;
    if (u_pass == 0u)
    {
        if (id == 0u) initializeRoot();
        return;
    }
    if (metadata.y != 0u) return;
    if (u_pass == 1u) markOctant(id);
    else if (u_pass == 2u) allocateChildren(id);
    else if (u_pass == 3u) linkLeaf(id);
    else if (u_pass == 4u) aggregateNode(id);
}
